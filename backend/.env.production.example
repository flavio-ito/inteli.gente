PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=inteligente
PGUSER=inteligente_api
PGPASSWORD=use-um-secret-manager
PORT=3001
AUTH_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
NODE_ENV=production
CORS_ORIGIN=https://inteligente.exemplo.gov.br
COOKIE_SECURE=true
APP_BASE_URL=https://inteligente.exemplo.gov.br
SMTP_HOST=smtp.exemplo.gov.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASSWORD=use-um-secret-manager
SMTP_FROM=Portal da Gestão Municipal <nao-responda@exemplo.gov.br>
DKIM_DOMAIN_NAME=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=
ALLOW_PERSONAL_EMAIL_REGISTRATION=false
PERSONAL_EMAIL_TEST_MUNICIPIO_COD_IBGE=

# Sonar Municipal: roda no mesmo servidor e só aceita chamadas locais (a API não
# envia CORS e não fica exposta à internet). Informe apenas a URL base, sem /api.
# Se o backend rodar em container, use a rede sonarmunicipal_default e http://app:3000.
SONAR_API_URL=http://127.0.0.1:3000

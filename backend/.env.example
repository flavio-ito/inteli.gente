PGHOST=localhost
PGPORT=5432
PGDATABASE=inteligente
PGUSER=inteligente_api
PGPASSWORD=
PORT=3001
AUTH_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
ALLOW_PERSONAL_EMAIL_REGISTRATION=false
PERSONAL_EMAIL_TEST_MUNICIPIO_COD_IBGE=
APP_BASE_URL=http://localhost:8080
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASSWORD=senha-smtp
SMTP_FROM=Portal da Gestão Municipal <nao-responda@seu-dominio.gov.br>
DKIM_DOMAIN_NAME=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=

# Limite das consultas orientadas do assistente municipal.
ASSISTANT_RATE_LIMIT_MAX=30
ASSISTANT_RATE_LIMIT_WINDOW_MS=900000

# Sonar Municipal: roda no mesmo servidor e só aceita chamadas locais (a API não
# envia CORS e não fica exposta à internet). Informe apenas a URL base, sem /api.
# Se o backend rodar em container, use a rede sonarmunicipal_default e http://app:3000.
SONAR_API_URL=http://127.0.0.1:3000
